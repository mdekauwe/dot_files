if [ -f ~/.bashrc ]
then
    source ~/.bashrc
fi


# silence zsh message
export BASH_SILENCE_DEPRECATION_WARNING=1

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/mdekauwe/Downloads/google-cloud-sdk/path.bash.inc' ]; then . '/Users/mdekauwe/Downloads/google-cloud-sdk/path.bash.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/Users/mdekauwe/Downloads/google-cloud-sdk/completion.bash.inc' ]; then . '/Users/mdekauwe/Downloads/google-cloud-sdk/completion.bash.inc'; fi

# Python virtualenv for pip-only packages (created by install_ports.sh).
# Keep this LAST: it must come after the MacPorts PATH lines above, or
# python/pip resolve to MacPorts and pip installs into /opt/local again.
if [ -f "$HOME/.venvs/sci/bin/activate" ]; then
    # Don't prepend "(sci)" to PS1 -- keep the HAL 9000 prompt intact.
    export VIRTUAL_ENV_DISABLE_PROMPT=1
    source "$HOME/.venvs/sci/bin/activate"
fi
